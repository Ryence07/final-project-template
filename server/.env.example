# Copy to .env and fill in. .env is git-ignored; this file is committed.
# On a deployed host, set these in the dashboard instead.

DATABASE_URL=postgresql://username:password@host/database

CORS_ORIGINS=http://localhost:5173

NODE_ENV=development

APP_USERNAME=change-this-username
APP_PASSWORD=change-this-to-a-long-random-password

# Do NOT set PORT locally or on the host. The host sets it for you.
